rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role;
    }

    function hasRole(roles) {
      return signedIn() && role() in roles;
    }

    function notMembershipSecretary() {
      return signedIn() && role() != 'Membership Secretary';
    }

    function isPayrollOwner() {
      return signedIn()
        && resource.data.isPayrollGenerated == true
        && (
          (role() == 'Pastor' && resource.data.role == 'Pastor') ||
          (role() == 'Deaconess' && resource.data.role == 'Deaconess') ||
          (role() == 'Admin Assistant' && resource.data.role in ['Admin', 'Admin Assistant'])
        );
    }

    match /userProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role() == 'Treasurer');
      allow write: if false;
    }

    // Temporary passwords written by scripts/provision-user.js (Admin SDK)
    // for the Treasurer to hand out from the dashboard, then erase.
    match /pendingPasswords/{uid} {
      allow read, delete: if hasRole(['Treasurer']);
      allow create, update: if false;
    }

    match /userSignatures/{uid} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Auditor', 'District', 'Finance Chair', 'Chairperson']);
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /income/{docId} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Deaconess', 'Auditor', 'District', 'Finance Chair', 'Chairperson', 'Finance Committee']);
      allow create: if hasRole(['Treasurer', 'Money Counter']);
      allow update, delete: if hasRole(['Treasurer']);
    }

    match /expenses/{docId} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Deaconess', 'Auditor', 'District', 'Finance Chair', 'Chairperson', 'Finance Committee']) || isPayrollOwner();
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    match /members/{docId} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Deaconess', 'Auditor', 'District', 'Finance Chair', 'Chairperson', 'Money Counter', 'Membership Secretary', 'Finance Committee']);
      // Money Counter may add a new tither (tithe-entry.html "Add New Tither"
      // or a new member during income entry) but only as a plain roster
      // record: a short first/last name, filed under its own Member ID.
      allow create: if hasRole(['Treasurer', 'Membership Secretary'])
        || (hasRole(['Money Counter'])
          && request.resource.data.memberId == docId
          && request.resource.data.first is string && request.resource.data.first.size() > 0 && request.resource.data.first.size() <= 100
          && request.resource.data.last is string && request.resource.data.last.size() > 0 && request.resource.data.last.size() <= 100);
      allow update, delete: if hasRole(['Treasurer', 'Membership Secretary']);
    }

    match /attendance/{docId} {
      // Weekly records now carry guest names (membership-attendance.html), so
      // only the roles whose pages show attendance can read it.
      allow read: if hasRole(['Treasurer', 'Membership Secretary', 'Pastor', 'Deaconess', 'Auditor',
        'District', 'Finance Chair', 'Chairperson', 'Finance Committee']);
      allow create, update, delete: if hasRole(['Treasurer', 'Membership Secretary']);
    }

    match /membershipRoll/{docId} {
      // The actual official church membership roll (members.html) - distinct
      // from the `members` collection above, which despite its name is the
      // tither roster used by tithers.html/member-report and is left
      // untouched. Now also read by membership-attendance.html (its
      // attendance roster and the present/absent + visitation reports) for
      // Deaconess/Pastor/Chairperson, who view those reports read-only -
      // only Treasurer/Membership Secretary can create/update/delete.
      allow read: if hasRole(['Treasurer', 'Membership Secretary', 'Deaconess', 'Pastor', 'Chairperson']);
      allow create, update, delete: if hasRole(['Treasurer', 'Membership Secretary']);
    }

    match /churchObligations/{docId} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Deaconess', 'Auditor', 'District', 'Finance Chair', 'Chairperson', 'Finance Committee']);
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    // reportReviews helpers (see the update rule below).
    function sigOf(data, k) {
      return data.get('signatures', {}).get(k, null);
    }
    function sigsKept(keys) {
      return keys.size() == 0
        || (sigOf(request.resource.data, keys[0]) == sigOf(resource.data, keys[0])
          && (keys.size() < 2 || sigOf(request.resource.data, keys[1]) == sigOf(resource.data, keys[1]))
          && (keys.size() < 3 || sigOf(request.resource.data, keys[2]) == sigOf(resource.data, keys[2]))
          && (keys.size() < 4 || sigOf(request.resource.data, keys[3]) == sigOf(resource.data, keys[3])));
    }
    function ownSig(k) {
      return sigOf(request.resource.data, k) != null
        && sigOf(request.resource.data, k).uid == request.auth.uid;
    }
    // A signer's step changes only the routing/state fields, and appends
    // exactly one history entry written in their own name.
    function reviewStepOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'routeTo', 'signatures', 'returnNotes', 'finalizedAt', 'finalizedBy',
          'lastAction', 'lastActionBy', 'lastActionRole', 'history', 'updatedAt'])
        && request.resource.data.history.size() == resource.data.get('history', []).size() + 1
        && request.resource.data.history[request.resource.data.history.size() - 1].actorUid == request.auth.uid;
    }

    match /reportReviews/{docId} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Deaconess', 'Auditor', 'District', 'Finance Chair', 'Chairperson', 'Finance Committee']);
      allow create: if hasRole(['Treasurer']);
      // The Treasurer runs the workflow. Every other signer may only take
      // the ONE step that is theirs (report-workflow.html), add only their
      // OWN signature, and leave every earlier signer's signature exactly as
      // it was - so nobody can approve or sign in someone else's name.
      allow update: if hasRole(['Treasurer'])
        || (reviewStepOnly()
          && (
            (role() == 'Auditor' && resource.data.status == 'submitted_to_auditor'
              && sigsKept(['treasurer'])
              && ((request.resource.data.status == 'submitted_to_finance' && ownSig('auditor'))
                || request.resource.data.status == 'returned_by_auditor'))
            || (role() == 'Finance Chair' && resource.data.status == 'submitted_to_finance'
              && sigsKept(['treasurer', 'auditor'])
              && ((request.resource.data.status == 'routed_to_chairperson' && ownSig('financeChair'))
                || request.resource.data.status == 'returned_by_finance'))
            || (role() == 'Chairperson' && resource.data.status == 'routed_to_chairperson'
              && sigsKept(['treasurer', 'auditor', 'financeChair'])
              && request.resource.data.status == 'routed_to_pastor' && ownSig('chairperson'))
            || (role() == 'Pastor' && resource.data.status == 'routed_to_pastor'
              && sigsKept(['treasurer', 'auditor', 'financeChair', 'chairperson'])
              && request.resource.data.status == 'finalized' && ownSig('pastor'))
          ));
      allow delete: if hasRole(['Treasurer']);
    }

    match /notifications/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /liquidationRequests/{docId} {
      // Read/update trust the Pastor/Deaconess/Admin Assistant role group as
      // a whole, not just the individual requesterUid on the doc - a small
      // church often has one of these staff complete the paperwork/receipts
      // for a cash advance actually received by another (e.g. Admin
      // Assistant liquidating on behalf of a Deaconess). requesterUid is
      // still recorded at creation and can't be reassigned on update, so the
      // audit trail of who originally requested the funds is unaffected.
      allow read: if hasRole(['Treasurer', 'Auditor', 'Pastor', 'Deaconess', 'Admin Assistant']);
      // Staff may only file a new request awaiting review - never one that
      // already reads Approved/Released/Completed.
      allow create: if (hasRole(['Pastor', 'Deaconess', 'Admin Assistant'])
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.status == 'Submitted')
        || hasRole(['Treasurer']);
      allow update: if hasRole(['Treasurer'])
        || (hasRole(['Pastor', 'Deaconess', 'Admin Assistant'])
          && request.resource.data.requesterUid == resource.data.requesterUid
          && (
            // Edit or cancel a request while it is still awaiting review.
            (resource.data.status == 'Submitted'
              && request.resource.data.status in ['Submitted', 'Cancelled'])
            // Submit liquidation for a released cash advance; the released
            // amount and request type cannot be altered by whoever submits.
            || (resource.data.status == 'Released'
              && request.resource.data.status == 'Liquidation Submitted'
              && request.resource.data.amount == resource.data.amount
              && request.resource.data.type == resource.data.type)
            // Draw/adjust receipt highlights on a submitted liquidation while
            // it awaits the Treasurer's review: only liquidationItems (where
            // the per-item highlights live) and updatedAt may change, the
            // status stays put and the item count cannot change.
            || (resource.data.status == 'Liquidation Submitted'
              && request.resource.data.status == 'Liquidation Submitted'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liquidationItems', 'updatedAt'])
              && request.resource.data.liquidationItems.size() == resource.data.liquidationItems.size())
          ));
      allow delete: if hasRole(['Treasurer']);
    }

    match /specialProjects/{docId} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Deaconess', 'Auditor', 'District', 'Finance Chair', 'Chairperson', 'Finance Committee']);
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    match /specialProjectEntries/{docId} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Deaconess', 'Auditor', 'District', 'Finance Chair', 'Chairperson', 'Finance Committee']);
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    match /specialProjectCosts/{docId} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Deaconess', 'Auditor', 'District', 'Finance Chair', 'Chairperson', 'Finance Committee']);
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    match /auditLogs/{docId} {
      // Append-only. The log exists so the Auditor can check the Treasurer's
      // work, so no role - the Treasurer included - may edit or delete an
      // entry after it is written, and an entry must name its real writer
      // (actorUid == the signed-in uid) so nobody can log an action under
      // someone else's name. Maintenance scripts use the Admin SDK, which
      // bypasses these rules.
      allow read: if hasRole(['Treasurer', 'Auditor']);
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /budgets/{docId} {
      allow read: if notMembershipSecretary();
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    match /settings/{docId} {
      // Money Counter only needs the year list for tithe-entry.html's year
      // picker - not opening balances, payroll, vouchers or council notes.
      allow read: if notMembershipSecretary()
        && (role() != 'Money Counter' || docId == 'yearsConfig');
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    match /certificates/{docId} {
      // Full certificate (section totals, signatures, issuer) - Treasurer and
      // Pastor only. The public verify page reads certificateVerifications.
      allow read: if hasRole(['Treasurer', 'Pastor']);
      allow create: if hasRole(['Treasurer']);
      allow update: if hasRole(['Treasurer', 'Pastor']);
      allow delete: if hasRole(['Treasurer']);
    }

    match /certificateVerifications/{docId} {
      // The public QR check (verify-certificate.html) reads only this small
      // copy - number, name, period, total, issue date, status, fully-signed.
      // A single get by the unguessable certificate id; never listable by
      // the public. The Pastor's step may only flip `fullySigned`.
      allow get: if true;
      allow list: if hasRole(['Treasurer']);
      allow create, delete: if hasRole(['Treasurer']);
      allow update: if hasRole(['Treasurer'])
        || (hasRole(['Pastor'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullySigned', 'updatedAt']));
    }

    match /equipment/{docId} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Deaconess', 'Auditor', 'District', 'Finance Chair', 'Chairperson']);
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    match /reportArchive/{docId} {
      // Saved, dated snapshots of Financial Overview / Reports / Budget vs
      // Actual (see report-archive.html) - generated by the Treasurer only,
      // viewable by the roles who need to study historical versions without
      // live edit/transaction-detail access to the source pages themselves.
      allow read: if hasRole(['Treasurer', 'Auditor', 'Pastor', 'Chairperson', 'Finance Committee']);
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    match /receiptRotations/{docId} {
      // Saved viewing angle of a receipt/count-sheet photo (receipt-rotation.js),
      // keyed by a hash of its storage path. Display setting only - the image
      // and its highlights are untouched. Everyone who can open a receipt reads
      // it; only the Treasurer saves it.
      allow read: if notMembershipSecretary();
      allow create, update: if hasRole(['Treasurer'])
        && request.resource.data.rotation in [0, 90, 180, 270]
        && request.resource.data.path is string;
      allow delete: if hasRole(['Treasurer']);
    }

    match /cashVouchers/{docId} {
      // Digital cash vouchers (cash-voucher.html) - the electronic counterpart of
      // the church's paper cash voucher form. Only the Treasurer releases funds, so
      // only the Treasurer can create or amend one; the reviewing roles read them.
      allow read: if hasRole(['Treasurer', 'Auditor', 'Pastor', 'Finance Chair', 'Chairperson', 'District', 'Finance Committee']);
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    match /countSheets/{docId} {
      // One doc per Sunday counting session (tithe-entry.html), holding the
      // counted denomination breakdown and any photographed count-sheet
      // files - see CLAUDE.md. Money Counter is create-only here exactly as
      // it is on income: it can save the sheet it just counted but never
      // revise one afterward, and it has no read access at all (matching
      // its lack of read on income).
      allow read: if hasRole(['Treasurer', 'Auditor', 'Pastor', 'Finance Chair', 'Chairperson', 'Finance Committee']);
      allow create: if hasRole(['Treasurer', 'Money Counter']);
      allow update, delete: if hasRole(['Treasurer']);
    }

    // Historical finance data (2018-2025), imported by historical-import.html.
    // Aggregates for dashboards/trend displays ONLY. Nothing here is read by any
    // balance, cash-level, report or ledger page - see CLAUDE.md "Historical data".
    match /historicalMonthly/{docId} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Deaconess', 'Auditor', 'District', 'Finance Chair', 'Chairperson', 'Finance Committee']);
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    match /historicalAnnual/{docId} {
      allow read: if hasRole(['Treasurer', 'Pastor', 'Deaconess', 'Auditor', 'District', 'Finance Chair', 'Chairperson', 'Finance Committee']);
      allow create, update, delete: if hasRole(['Treasurer']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
